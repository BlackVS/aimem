{
  "version": 1,
  "contract": "enrollment.v1",
  "status": "proposed (D1-w); D1-a adds the fake-consumer test that reads this file",
  "note": "Every secret here is a sample. A fixture test checks that no sample secret appears in a response other than the issue answer and the subcode record, or in an audit example.",
  "sample_secrets": {
    "subcode": "aes1_8JXVhYHoE8fiN07yDgAiAeJTimaMXKhC6NOiwhhIu2I",
    "bearer": "aimem_user_sample-bearer-never-on-the-wire-in-clear",
    "delivery_private_key": "c2FtcGxlLXByaXZhdGUta2V5LW5ldmVyLW9uLXdpcmUhIQ"
  },
  "bounds": {
    "subcode_default_lifetime_seconds": 86400,
    "subcode_max_lifetime_seconds": 259200,
    "delivery_retention_seconds": 3600,
    "redemptions_per_minute_per_address": 10,
    "redemptions_per_minute_per_bundle": 20,
    "token_lifetime_days": 365,
    "subcode_record_max_bytes": 16384,
    "redemption_body_max_bytes": 4096,
    "client_attempts_per_run": 5,
    "client_attempt_timeout_seconds": 10
  },
  "suite": {
    "name": "hpke-x25519-sha256-chacha20poly1305",
    "kem": "0x0020",
    "kdf": "0x0001",
    "aead": "0x0003",
    "info": "aimem enrollment.v1 delivery",
    "aad_template": "enrollment.v1|<hub_id>|<bundle_id>|<request key, k1_ form>|<user_id>|<token_id>",
    "plaintext_fields": ["token", "user_id", "token_id", "hub_id"]
  },
  "exchanges": [
    {
      "case": "issue",
      "request": {
        "method": "POST",
        "path": "/v1/identity/enrollments",
        "headers": {"X-Aimem-Enrollment-Version": "1", "Authorization": "Bearer <hub admin token>"},
        "body": {"bundle_id": "01a10c90-0000-7000-8000-000000000001", "purpose": "new_user", "expires_at": "2026-10-06T12:00:00Z"}
      },
      "response": {
        "status": 201,
        "headers": {"Cache-Control": "no-store"},
        "body": {"bundle_id": "01a10c90-0000-7000-8000-000000000001", "purpose": "new_user", "expires_at": "2026-10-06T12:00:00Z",
                 "hub_id": "01a09fc8-0000-7000-8000-00000000a1b2", "subcode": "aes1_8JXVhYHoE8fiN07yDgAiAeJTimaMXKhC6NOiwhhIu2I"}
      },
      "audit": {"event": "enrollment.issued", "subject": "bundle=01a10c90-0000-7000-8000-000000000001 purpose=new_user expires_at=2026-10-06T12:00:00Z"}
    },
    {
      "case": "issue_lost_reply_retry",
      "request": {"method": "POST", "path": "/v1/identity/enrollments",
                  "body": {"bundle_id": "01a10c90-0000-7000-8000-000000000001", "purpose": "new_user", "expires_at": "2026-10-06T12:00:00Z"}},
      "response": {"status": 409, "body": {"code": "enrollment_exists", "retryable": false, "next_action": "Revoke the bundle and issue a new one; its subcode cannot be shown again."}}
    },
    {
      "case": "subcode_record",
      "stdout_of": "aimem identity enroll issue --purpose new-user --expires 24h --output -",
      "record": {"kind": "aimem-enrollment", "version": 1, "bundle_id": "01a10c90-0000-7000-8000-000000000001", "purpose": "new_user",
                 "subcode": "aes1_8JXVhYHoE8fiN07yDgAiAeJTimaMXKhC6NOiwhhIu2I", "expires_at": "2026-10-06T12:00:00Z",
                 "hub": {"hub_id": "01a09fc8-0000-7000-8000-00000000a1b2", "url": "https://hub.example.test:8443",
                         "trust": {"spki_sha256": "sha256-c2FtcGxlLXNwa2ktcGluLW9mLXRoZS1odWItY2VydA"}}}
    },
    {
      "case": "redeem",
      "request": {
        "method": "POST",
        "path": "/v1/identity/enrollments/redemptions",
        "headers": {"X-Aimem-Enrollment-Version": "1", "Idempotency-Key": "k1_kJeacZCQdDItXKghIqGs-VmiaeU10v5XmhX_IVpBNXc"},
        "body": {"hub_id": "01a09fc8-0000-7000-8000-00000000a1b2", "subcode": "aes1_8JXVhYHoE8fiN07yDgAiAeJTimaMXKhC6NOiwhhIu2I",
                 "label": "member-laptop",
                 "delivery": {"suite": "hpke-x25519-sha256-chacha20poly1305", "public_key": "ZwyTtM6-bjHVuU8Koj0coK3wKptqm5CUCtFmp8ffWoY"}}
      },
      "response": {
        "status": 200,
        "headers": {"Cache-Control": "no-store"},
        "body": {"bundle_id": "01a10c90-0000-7000-8000-000000000001", "replayed": false, "hub_id": "01a09fc8-0000-7000-8000-00000000a1b2",
                 "identity": {"user_id": "01a10c91-0000-7000-8000-0000000000u1", "token_id": "01a10c91-0000-7000-8000-0000000000t1"},
                 "delivery": {"suite": "hpke-x25519-sha256-chacha20poly1305", "enc": "c2FtcGxlLWVuY2Fwc3VsYXRlZC1rZXk", "ciphertext": "c2FtcGxlLXNlYWxlZC1wbGFpbnRleHQ"},
                 "redeemed_at": "2026-10-05T12:05:00Z"}
      },
      "audit": {"event": "enrollment.redeemed", "subject": "bundle=01a10c90-0000-7000-8000-000000000001 user=01a10c91-0000-7000-8000-0000000000u1 token=01a10c91-0000-7000-8000-0000000000t1 label=member-laptop"}
    },
    {
      "case": "redeem_identical_retry",
      "same_request_as": "redeem",
      "response": {"status": 200, "body_differs_from_redeem_only_in": {"replayed": true}}
    },
    {
      "case": "redeem_other_key",
      "same_request_as": "redeem",
      "but": {"Idempotency-Key": "k1_VtMDnUctrHC97enGCJFnsLKFtHyhn_rwCBHHzCeaCtE"},
      "response": {"status": 409, "body": {"code": "enrollment_conflict", "retryable": false}}
    },
    {
      "case": "revoke_issued",
      "request": {"method": "POST", "path": "/v1/identity/enrollments/01a10c90-0000-7000-8000-000000000002/revocation"},
      "response": {"status": 200, "body": {"bundle_id": "01a10c90-0000-7000-8000-000000000002", "state": "revoked"}},
      "audit": {"event": "enrollment.revoked", "subject": "bundle=01a10c90-0000-7000-8000-000000000002"}
    },
    {
      "case": "revoke_redeemed",
      "request": {"method": "POST", "path": "/v1/identity/enrollments/01a10c90-0000-7000-8000-000000000001/revocation"},
      "response": {"status": 409, "body": {"code": "enrollment_redeemed", "retryable": false,
                                           "redeemed": {"user_id": "01a10c91-0000-7000-8000-0000000000u1", "token_id": "01a10c91-0000-7000-8000-0000000000t1"}}}
    },
    {
      "case": "list",
      "request": {"method": "GET", "path": "/v1/identity/enrollments?state=redeemed"},
      "response": {"status": 200, "body": {"enrollments": [
        {"bundle_id": "01a10c90-0000-7000-8000-000000000001", "purpose": "new_user", "state": "redeemed", "created_at": "2026-10-05T12:00:00Z",
         "expires_at": "2026-10-06T12:00:00Z", "issued_by": "admin", "user_name": "",
         "redeemed": {"user_id": "01a10c91-0000-7000-8000-0000000000u1", "token_id": "01a10c91-0000-7000-8000-0000000000t1", "at": "2026-10-05T12:05:00Z"}}]}}
    }
  ],
  "refusals": [
    {"case": "bad_version", "code": "unsupported_version", "http_status": 400, "retryable": false},
    {"case": "malformed_body", "code": "invalid_request", "http_status": 400, "retryable": false},
    {"case": "plain_http", "code": "tls_required", "http_status": 403, "retryable": false},
    {"case": "ordinary_token_on_issue", "code": "credential_scope_forbidden", "http_status": 403, "retryable": false},
    {"case": "peer_credential_on_issue", "code": "peer_forbidden", "http_status": 403, "retryable": false},
    {"case": "unknown_expired_revoked_or_wrong_hub_subcode", "code": "enrollment_invalid", "http_status": 403, "retryable": false},
    {"case": "subcode_with_other_key", "code": "enrollment_conflict", "http_status": 409, "retryable": false},
    {"case": "issue_retry_after_lost_reply", "code": "enrollment_exists", "http_status": 409, "retryable": false},
    {"case": "revoke_after_redemption", "code": "enrollment_redeemed", "http_status": 409, "retryable": false},
    {"case": "revoke_unknown_bundle", "code": "not_found", "http_status": 404, "retryable": false},
    {"case": "bundle_id_with_other_input", "code": "idempotency_conflict", "http_status": 409, "retryable": false},
    {"case": "too_many_redemptions", "code": "rate_limited", "http_status": 429, "retryable": true},
    {"case": "store_unavailable", "code": "enrollment_unavailable", "http_status": 503, "retryable": true}
  ],
  "client_refusals": [
    {"code": "identity_mismatch", "exit": 3, "when": "the delivery does not open, or its IDs differ from the answer or the record, or the hub entry names another URL"},
    {"code": "delivery_unavailable", "exit": 3, "when": "the installation cannot create its owner-only pending state; nothing was sent"}
  ]
}
