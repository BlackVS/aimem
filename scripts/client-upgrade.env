# Read by scripts/check-client-upgrade.sh and scripts/check-client-upgrade.ps1:
# NAME=value lines only. The two versions the check moves between are not
# here: scripts/upgrade-versions.sh derives them from the tags.
#
# The first release whose `aimem upgrade` ends a failed run with the line
# "the upgrade to <TO> failed and was rolled back: ...". The check asserts
# that line once the previous release is this release or a later one.
ROLLBACK_LINE_SINCE=v0.10.26
