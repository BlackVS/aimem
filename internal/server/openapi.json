        "responses": {
          "200": {
            "description": "console page"
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "Task page shell (HTML, holds no data; asks for a token in the browser; works with ordinary project tokens)",
        "x-role": "public",
        "security": [],
        "responses": {
          "200": {
            "description": "task page"
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Public status JSON",
        "x-role": "public",
        "security": [],
        "responses": {
          "200": {
            "description": "liveness, build, hostname, uptime"
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "This specification",
        "x-role": "writer",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 document"
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Service health: project count, state root, version, resources",
        "x-role": "writer",
        "responses": {
          "200": {
            "description": "health object"
          }
        }
      }
    },
    "/v1/events": {
      "post": {
        "summary": "Append one checkpoint event (idempotent on idempotency_key); groups and hub binding ride along into project meta",
        "x-role": "writer",
        "responses": {
          "200": {
            "description": "{id, inserted}"
          }
        }
      }
    },
    "/v1/projects": {
      "get": {
        "summary": "List project ids",
        "description": "Also available to ordinary user tokens, which receive the ordinary projects only (the user memory store and the knowledge groups are filtered out); legacy writer and admin credentials receive every id.",
        "x-role": "writer",
        "responses": {
          "200": {
            "description": "project id list"
          }
        }
      }
    },
    "/v1/projects/{p}": {
      "delete": {
        "summary": "Drop a project (files deleted; a read never resurrects it)",
        "x-role": "admin",
        "parameters": [
          {
